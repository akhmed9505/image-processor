# Demonstration values. Export these variables to override YAML.
LOG_LEVEL=info
LOG_FORMAT=json

POSTGRES_HOST=localhost
POSTGRES_PORT=55433
POSTGRES_DB=imageprocessor
POSTGRES_USER=imageprocessor
POSTGRES_PASSWORD=local-postgres-password
# Optional: POSTGRES_MAX_CONNS=10, POSTGRES_TIMEOUT=5s

MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=images
MINIO_SECURE=false
MINIO_ACCESS_KEY=local-minio-user
MINIO_SECRET_KEY=local-minio-password
# Optional: MINIO_PORT=9000, MINIO_CONSOLE_PORT=9001, MINIO_TIMEOUT=5s
